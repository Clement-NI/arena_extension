apiVersion: chaos-mesh.org/v1alpha1
kind: NetworkChaos
metadata:
  name: {{ from_app }}-to-{{ to_app }}-loss
spec:
  action: loss
  mode: all
  selector:
    namespaces:
      - default
    labelSelectors:
      app: {{ from_app }}
  direction: to
  target:
    mode: all
    selector:
      namespaces:
        - default
      labelSelectors:
        app: {{ to_app }}
  loss:
    loss: "{{ loss_pct }}"
    correlation: "0"
